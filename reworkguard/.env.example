# Copy to .env (or run scripts/setup-dev.sh, which generates random values). Never commit .env.
MYSQL_PORT=3306
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# HMAC key for access tokens: at least 32 characters.
JWT_SIGNING_KEY=change-me-change-me-change-me-change-me-0123
# Password of every seeded demo user (admin@reworkguard.local, manager@..., etc.).
SEED_PASSWORD=change-me-demo
# Host ports (bound to 127.0.0.1).
WEB_PORT=8080
API_PORT=5080
MAILHOG_UI_PORT=8025
# Development-only clock control used by scripts/seed-demo; false disables it.
DEV_CLOCK_CONTROL=true
