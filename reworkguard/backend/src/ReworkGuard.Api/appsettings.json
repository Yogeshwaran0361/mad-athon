{
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "reworkguard-api",
    "Audience": "reworkguard-clients",
    "AccessTokenMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Notifications": {
    "AppBaseUrl": "http://localhost:5173",
    "OutboxBatchSize": 50
  },
  "Email": {
    "Provider": "Log",
    "FromAddress": "no-reply@reworkguard.local",
    "FromName": "ReworkGuard",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "EnableSsl": false
    },
    "Ses": {
      "Region": "",
      "ConfigurationSetName": ""
    }
  },
  "Jobs": {
    "Enabled": true,
    "RunServer": true,
    "WorkerCount": 4,
    "OutboxCron": "*/15 * * * * *",
    "DeductionWindowsCron": "*/5 * * * *",
    "WarrantySweepCron": "30 1 * * *",
    "RemindersCron": "0 9 * * 1-5"
  },
  "Auth": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "RefreshTokenDays": 7,
    "SecureCookie": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    }
  }
}
